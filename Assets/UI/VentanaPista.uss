.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.tarjeta {
    width: 500px;
    padding: 20px;
    background-color: #1E1E1E;
    border-radius: 10px;
    border-width: 1px;
    border-color: #FFFFFF;
}

#lbl-titulo {
    color: #FFD700;
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

#lbl-contenido {
    color: #E0E0E0;
    font-size: 15px;
    margin-bottom: 20px;
    white-space: normal;
}

#btn-cerrar {
    padding: 10px;
    background-color: #3A3A3A;
    color: #FFFFFF;
    border-radius: 5px;
    font-size: 14px;
    align-self: center;
}
