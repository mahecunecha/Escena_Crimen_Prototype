<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd">

    <ui:VisualElement name="ContenedorRaiz" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0,0,0,0.85); justify-content: center; align-items: center; display: none;">
        <ui:VisualElement style="background-color: #1a1a1a; padding: 40px; border-radius: 15px; border-width: 2px; border-color: #555555; align-items: center; width: 400px;">
            <ui:Label name="lblTitulo" style="font-size: 32px; -unity-font-style: bold; color: #ffffff; margin-bottom: 10px;" />
            <ui:Label name="lblMensaje" style="font-size: 16px; color: #cccccc; margin-bottom: 30px; white-space: normal;" />
            <ui:Button name="btnReanudar" text="Continuar" style="width: 200px; height: 40px; margin-bottom: 10px; background-color: #333333; color: white; border-radius: 5px;" />
            <ui:Button name="btnSalir" text="Salir del Juego" style="width: 200px; height: 40px; background-color: #802020; color: white; border-radius: 5px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
